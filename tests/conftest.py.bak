        os.Exit(1)
    }

    if err := mgr.Start(signals.SetupSignalHandler()); err != nil {
        os.Exit(1)
    }
}
''',
        "go.mod": '''
module github.com/test/controller

go 1.19

require (
    k8s.io/api v0.26.0
    k8s.io/apimachinery v0.26.0
    sigs.k8s.io/controller-runtime v0.15.0
)
''',
        "api/v1alpha1/vectordb_types.go": '''
package v1alpha1

import (
    metav1 "k8s.io/apimachinery/pkg/apis/meta/v1/types"
)

// VectorDBSpec defines the desired state of VectorDB
type VectorDBSpec struct {
    EngineType string `json:"engineType"`
    Replicas   int    `json:"replicas"`
}

// VectorDBStatus defines the observed state of VectorDB
type VectorDBStatus struct {
    // Add status fields here
}

//+kubebuilder:object:root=true
//+kubebuilder:subresource:status

type VectorDB struct {
    metav1.TypeMeta   `json:",inline"`
    metav1.ObjectMeta `json:"metadata,omitempty"`
    Spec   VectorDBSpec   `json:"spec,omitempty"`
    Status VectorDBStatus `json:"status,omitempty"`
}
''',
        "config/crd/bases/platform.test.io_vectordbs.yaml": '''
apiVersion: apiextensions.k8s.io/v1
kind: CustomResourceDefinition
metadata:
  name: vectordbs.platform.test.io
spec:
  group: platform.test.io
  names:
    kind: VectorDB
    plural: vectordbs
  scope: Namespaced
  versions:
  - name: v1alpha1
    served: true
    storage: true
    schema:
      openAPIV3Schema:
        type: object
        properties:
          spec:
            type: object
            properties:
              engineType:
                type: string
              replicas:
                type: integer
'''
    }


