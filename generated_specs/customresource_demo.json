{
  "openapi": "3.0.0",
  "info": {
    "title": "CustomResource API",
    "version": "v1alpha1",
    "description": "Sample custom resource API"
  },
  "paths": {},
  "components": {
    "schemas": {
      "CustomResource": {
        "type": "object",
        "properties": {
          "apiVersion": {
            "type": "string",
            "description": "API version, e.g., platform.cnoe.io/v1alpha1"
          },
          "kind": {
            "type": "string",
            "description": "Resource kind, e.g., CustomResource"
          },
          "metadata": {
            "type": "object",
            "properties": {
              "name": {
                "type": "string"
              },
              "namespace": {
                "type": "string"
              }
            }
          },
          "spec": {
            "type": "object",
            "properties": {
              "name": {
                "type": "string",
                "description": "Resource name"
              },
              "enabled": {
                "type": "boolean",
                "description": "Enable resource"
              },
              "config": {
                "type": "object",
                "description": "Configuration settings"
              }
            }
          }
        }
      }
    }
  }
}