{
  "openapi": "3.0.0",
  "info": {
    "title": "MLPipeline",
    "version": "v1alpha1",
    "description": "Machine learning training pipeline"
  },
  "paths": {
    "/apis/ml.platform.cnoe.io/v1alpha1/mlpipelines": {
      "post": {
        "summary": "Create MLPipeline",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/MLPipeline"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "MLPipeline created"
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "MLPipeline": {
        "type": "object",
        "properties": {
          "apiVersion": {
            "type": "string"
          },
          "kind": {
            "type": "string"
          },
          "metadata": {
            "type": "object",
            "properties": {
              "name": {
                "type": "string"
              },
              "namespace": {
                "type": "string"
              }
            }
          },
          "spec": {
            "type": "object",
            "properties": {
              "model_name": {
                "type": "string"
              },
              "training_steps": {
                "type": "integer",
                "format": "int32"
              },
              "gpu_enabled": {
                "type": "boolean"
              },
              "dataset_path": {
                "type": "string"
              },
              "hyperparameters": {
                "type": "string"
              }
            },
            "required": [
              "model_name",
              "training_steps",
              "gpu_enabled",
              "dataset_path",
              "hyperparameters"
            ]
          },
          "status": {
            "type": "object",
            "properties": {
              "phase": {
                "type": "string"
              },
              "message": {
                "type": "string"
              }
            }
          }
        }
      }
    }
  }
}