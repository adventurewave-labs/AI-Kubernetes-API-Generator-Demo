# =============================================================================
# AI-Assisted Platform Extension Generator - Environment Variables
# =============================================================================
# Copy this file to .env and fill in your actual values

# REQUIRED: OpenAI API Configuration
OPENAI_API_KEY=your-openai-api-key-here
OPENAI_MODEL=gpt-4
OPENAI_BASE_URL=https://api.openai.com/v1

# OpenRouter API Configuration (ALTERNATIVE TO OPENAI)
OPENROUTER_API_KEY=your-openrouter-api-key-here
OPENROUTER_MODEL=anthropic/claude-3.5-sonnet

# Optional: Alternative AI Providers
# ANTHROPIC_API_KEY=your-anthropic-api-key-here
# AZURE_OPENAI_API_KEY=your-azure-openai-api-key-here
# AZURE_OPENAI_ENDPOINT=your-azure-openai-endpoint-here

# Project Configuration
AI_AGENT_LOG_LEVEL=INFO
AI_AGENT_OUTPUT_DIR=./generated
AI_AGENT_CONFIG_FILE=./config/agent_config.yaml

# Development Settings
AI_AGENT_DEBUG=false
AI_AGENT_MOCK_MODE=false